# SafeTwin runs entirely with realistic local data unless this is set to false.
EXPO_PUBLIC_DEMO_MODE=true

# Production SafeTwin API and real-time alert endpoint (HTTPS / WSS only).
EXPO_PUBLIC_API_BASE_URL=https://api.safetwin.example/api
EXPO_PUBLIC_WS_URL=wss://api.safetwin.example/ws

# Google Maps API Key for Android & iOS native MapView
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyD7pTLraDteu0omzvUyv54q1o_GsXyibf8

# MapTiler Interactive & Static Map API Key
EXPO_PUBLIC_MAPTILER_API_KEY=e374d5252792483f99f04d514b160f47
EXPO_PUBLIC_STATIC_MAP_API_KEY=e374d5252792483f99f04d514b160f47

# NASA FIRMS API Key for live satellite thermal telemetry
EXPO_PUBLIC_NASA_FIRMS_MAP_KEY=6eb4f3abaac4eee67bd8773f2efc3ff6

# FCM project identifiers for a custom Expo development build.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
